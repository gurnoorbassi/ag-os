{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-os.local/schemas/opportunity.schema.json",
  "title": "AG OS Opportunity",
  "type": "object",
  "additionalProperties": true,
  "required": ["opportunityId", "type", "title", "status", "summary", "problemHypothesis", "observations", "hypotheses", "evidenceIds", "score", "scoreBreakdown", "confidence", "economicModel", "stopConditions", "createdAt", "updatedAt"],
  "properties": {
    "opportunityId": { "type": "string", "pattern": "^opportunity-[a-z0-9-]+$" },
    "type": { "type": "string", "enum": ["revenue_client", "business_problem", "strategic_relationship", "partnership", "market", "product", "business_build", "distribution", "reputation_content", "technology_shift", "internal_ag_bottleneck"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["discovered", "researching", "qualified", "watching", "validation_ready", "validating", "active", "won", "lost", "killed", "archived"] },
    "summary": { "type": "string", "minLength": 1 },
    "problemHypothesis": { "type": "string", "minLength": 1 },
    "observations": { "type": "array", "items": { "type": "object" } },
    "hypotheses": { "type": "array", "items": { "type": "string" } },
    "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "scoreBreakdown": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "economicModel": { "type": "object" },
    "stopConditions": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
