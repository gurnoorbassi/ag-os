{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-os.local/schemas/agent-run.schema.json",
  "title": "AG OS Runtime Agent Run",
  "type": "object",
  "additionalProperties": true,
  "required": ["agentRunId", "missionId", "role", "displayName", "provider", "model", "status", "allowedTools", "permissions", "tokenUsage", "costUsd", "lastActivityAt", "createdAt", "updatedAt"],
  "properties": {
    "agentRunId": { "type": "string", "pattern": "^agent-run-[a-z0-9-]+$" },
    "missionId": { "type": "string", "pattern": "^mission-[a-z0-9-]+$" },
    "role": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["idle", "waiting", "working", "blocked", "reviewing", "failed", "complete"] },
    "allowedTools": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "object" },
    "tokenUsage": { "type": "object" },
    "costUsd": { "type": "number", "minimum": 0 },
    "lastActivityAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
