{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-os.local/schemas/mission-task.schema.json",
  "title": "AG OS Mission Task",
  "type": "object",
  "additionalProperties": true,
  "required": ["taskId", "missionId", "title", "description", "assignedAgentRunId", "status", "dependencies", "acceptanceCriteria", "attempt", "maximumAttempts", "artifacts", "filesTouched", "commandsExecuted", "blockers", "reviewState", "createdAt", "updatedAt"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^mission-task-[a-z0-9-]+$" },
    "missionId": { "type": "string", "pattern": "^mission-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "assignedAgentRunId": { "type": "string", "pattern": "^agent-run-[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["waiting", "ready", "working", "reviewing", "blocked", "failed", "complete", "cancelled"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "maximumAttempts": { "type": "integer", "minimum": 1 },
    "artifacts": { "type": "array" },
    "filesTouched": { "type": "array", "items": { "type": "string" } },
    "commandsExecuted": { "type": "array" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "reviewState": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
