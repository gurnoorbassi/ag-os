{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-os.local/schemas/opportunity-treasury.schema.json",
  "title": "AG OS Opportunity Treasury",
  "type": "object",
  "additionalProperties": true,
  "required": ["treasuryId", "currency", "startingCapital", "availableCapital", "reservedCapital", "spentCapital", "revenueAttributed", "netContribution", "executionMode", "realMoneyMovementAdapter", "transactions", "createdAt", "updatedAt"],
  "properties": {
    "treasuryId": { "type": "string", "pattern": "^opportunity-treasury-[a-z0-9-]+$" },
    "currency": { "const": "USD" },
    "startingCapital": { "type": "number", "minimum": 0 },
    "availableCapital": { "type": "number", "minimum": 0 },
    "reservedCapital": { "type": "number", "minimum": 0 },
    "spentCapital": { "type": "number", "minimum": 0 },
    "revenueAttributed": { "type": "number", "minimum": 0 },
    "netContribution": { "type": "number" },
    "executionMode": { "const": "simulation_only" },
    "realMoneyMovementAdapter": { "type": "null" },
    "transactions": { "type": "array" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
