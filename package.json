{
  "name": "ag-os",
  "version": "0.0.0",
  "private": true,
  "description": "AG OS private owner-operated coordinator with approval-gated autonomous work, evidence, quality, memory, and deployment adapters.",
  "type": "module",
  "scripts": {
    "dashboard:build": "node scripts/build-dashboard.mjs",
    "dashboard:check": "node scripts/check-dashboard.mjs",
    "test": "node --test tests/*.test.mjs",
    "boot:check": "node scripts/boot-check.mjs",
    "approvals:stale": "node scripts/manage-stale-approvals.mjs --list",
    "proof:write": "node scripts/process-runtime-proof-writer.mjs",
    "connector:preflight": "node scripts/process-connector-preflight.mjs",
    "memory:load": "node scripts/load-accepted-lessons.mjs",
    "lessons:promote": "node scripts/process-lesson-promotion.mjs",
    "archetypes:propose": "node scripts/process-archetype-update-proposal.mjs",
    "safe-merge:check": "node scripts/check-safe-merge.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "mission:smoke:anthropic": "node scripts/run-live-mission-smoke.mjs",
    "mission:smoke:anthropic:resume": "node scripts/resume-live-mission-smoke.mjs",
    "opportunity:wake:fixture": "node scripts/run-opportunity-director.mjs --fixture fixtures/opportunity-director-v1-world.json",
    "opportunity:brief": "node scripts/run-opportunity-director.mjs --brief",
    "opportunity:verify": "node scripts/verify-opportunity-director.mjs",
    "opportunity:verify:v1-1": "node --test tests/opportunity-director.test.mjs tests/anthropic-budget-guard.test.mjs",
    "audit:v1": "node scripts/audit-v1-completion.mjs",
    "production:check": "node scripts/check-production-readiness.mjs",
    "production:check:coordinator": "node scripts/check-production-readiness.mjs --record .codex/production/production-readiness-ag-os-coordinator-v1.json",
    "live:start": "node scripts/build-dashboard.mjs && node scripts/live-server.mjs",
    "validate": "node scripts/validate-foundation.mjs && node scripts/check-dashboard.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
